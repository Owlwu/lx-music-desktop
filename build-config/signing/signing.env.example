# 复制为 signing.env 后按平台填写。实际的 signing.env 由 Git 忽略。

# Windows 证书路径（.p12 / .pfx），相对路径以项目根目录为准
CSC_LINK=./build-config/signing/lxmusic-codesign.p12
CSC_KEY_PASSWORD=

# macOS 钥匙串里的签名身份，Apple 证书名称省略 Developer ID Application: 前缀
MAC_SIGN_IDENTITY=LX Music Dev Signing

# 1 = 使用已配置的 Apple 凭据公证
MAC_NOTARIZE=0
